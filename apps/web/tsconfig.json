{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@abracode/presentation/ui": ["../../packages/presentation/src/ui"],
      "@abracode/presentation/utils": ["../../packages/presentation/src/utils.ts"]
    },
    "types": ["vite-plus/client"]
  },
  "include": ["src", "vite.config.ts"]
}
