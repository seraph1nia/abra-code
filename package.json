{
  "name": "abracode",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "pnpm format:check && pnpm lint:effect && pnpm check:packages && pnpm typecheck && pnpm check:lsp && pnpm check:lsp:agents",
    "contracts:check": "pnpm --filter @abracode/contracts check",
    "presentation:check": "pnpm --filter @abracode/presentation check",
    "test": "vp test run --project fast --project unit --project integration",
    "test:e2e": "pnpm web:build && vp test run --project e2e",
    "test:soak": "tsx packages/runtime/tests/operational/soak.ts",
    "doctor": "tsx scripts/cli.ts doctor",
    "browser:install": "agent-browser install",
    "serve": "tsx scripts/cli.ts serve",
    "start": "tsx scripts/cli.ts start",
    "web": "tsx scripts/cli.ts web",
    "service:restart": "tsx scripts/cli.ts stop && tsx scripts/cli.ts serve",
    "attach": "tsx scripts/cli.ts attach",
    "pair": "tsx scripts/cli.ts attach --pair",
    "service:stop": "tsx scripts/cli.ts stop",
    "auth": "tsx scripts/cli.ts attach --auth",
    "format:check": "vp fmt --check",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm lint:effect",
    "format": "vp fmt",
    "test:watch": "vp test watch --project fast --project unit --project integration",
    "build": "vp pack && pnpm web:build && pnpm report:prepare",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "lint:effect": "vp lint --type-aware --deny-warnings",
    "check:lsp": "effect-tsgo diagnostics --project packages/runtime/tsconfig.json --format json --strict --lspconfig '{\"diagnostics\":true,\"diagnosticSeverity\":{\"unstableApiUsage\":\"off\"}}'",
    "check:lsp:agents": "effect-tsgo diagnostics --project packages/agents/tsconfig.json --format json --strict --lspconfig '{\"diagnostics\":true,\"diagnosticSeverity\":{\"unstableApiUsage\":\"off\"}}'",
    "report:check": "pnpm --filter @abracode/report-export check",
    "report:preview": "tsx scripts/cli.ts report preview",
    "report:validate": "tsx apps/report/scripts/validate.ts",
    "report:browser:install": "pnpm --filter @abracode/report-export exec playwright install chromium",
    "service:start": "tsx scripts/cli.ts serve",
    "config:validate": "tsx scripts/cli.ts config validate",
    "config:show": "tsx scripts/cli.ts config show",
    "express:signatures": "tsx packages/runtime/scripts/express-signatures.ts",
    "config:schema": "tsx scripts/cli.ts config schema",
    "licenses:refresh": "node scripts/licensing/refresh.mjs",
    "licenses:check": "node --test scripts/licensing/check.test.mjs && node scripts/licensing/check.mjs",
    "config:apply": "tsx scripts/cli.ts config apply",
    "config:status": "tsx scripts/cli.ts config status",
    "web:build": "pnpm --filter @abracode/web build",
    "web:check": "pnpm --filter @abracode/web check",
    "dev": "tsx scripts/cli.ts dev",
    "report:export": "tsx scripts/cli.ts report export",
    "runtime:check": "pnpm --filter @abracode/runtime check",
    "report:prepare": "tsx scripts/cli.ts report prepare",
    "check:packages": "pnpm -r --sort --workspace-concurrency=1 run check",
    "test:fast": "vp test run --project fast",
    "test:unit": "vp test run --project unit",
    "test:integration": "vp test run --project integration",
    "test:one": "vp test run",
    "test:affected": "vp test related --run --project fast --project unit --project integration",
    "test:all": "pnpm web:build && pnpm test:prepared",
    "test:prepared": "vp test run --project fast --project unit --project integration --project e2e",
    "test:native": "vp test run --project extended --project e2e native",
    "test:core": "vp test run --project fast --project unit",
    "test:extended": "vp test run --project extended"
  },
  "dependencies": {
    "@abracode/runtime": "workspace:*"
  },
  "devDependencies": {
    "@alibaba-group/open-code-review": "1.13.13",
    "@effect/tsgo": "0.69.0",
    "@fission-ai/openspec": "2.0.0",
    "@opencode/cli": "2.3.0",
    "@types/node": "26.6.6",
    "agent-browser": "0.43.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite-plus": "1.6.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=26.4.0"
  },
  "packageManager": "pnpm@12.21.0"
}
