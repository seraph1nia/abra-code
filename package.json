{
  "name": "abracode",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "vp check && pnpm typecheck && pnpm lint:effect && pnpm check:lsp && pnpm report:check",
    "test": "vp test run --project unit --project integration",
    "test:e2e": "vp test run --project e2e",
    "doctor": "tsx scripts/doctor.ts",
    "browser:install": "agent-browser install",
    "serve": "tsx scripts/start.ts",
    "start": "tsx scripts/launch.ts",
    "service:restart": "tsx scripts/stop.ts && tsx scripts/start.ts",
    "attach": "tsx scripts/client.ts",
    "pair": "tsx scripts/client.ts --pair",
    "service:stop": "tsx scripts/stop.ts",
    "auth": "tsx scripts/client.ts --auth",
    "format:check": "vp fmt --check",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint && pnpm lint:effect",
    "format": "vp fmt",
    "test:watch": "vp test watch --project unit --project integration",
    "build": "vp pack",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "lint:effect": "vp lint --type-aware --deny-warnings",
    "check:lsp": "effect-tsgo diagnostics --project tsconfig.json --format json --strict --lspconfig '{\"diagnostics\":true,\"diagnosticSeverity\":{\"unstableApiUsage\":\"off\"}}'",
    "report:dev": "pnpm --filter @abracode/report-template dev",
    "report:check": "pnpm --filter @abracode/report-template check",
    "report:build": "pnpm --filter @abracode/report-template build",
    "report:preview": "pnpm --filter @abracode/report-template preview",
    "report:validate": "tsx templates/reporter/scripts/validate.ts",
    "report:browser:install": "pnpm --filter @abracode/report-template exec playwright install chromium",
    "service:start": "tsx scripts/start.ts",
    "config:validate": "tsx scripts/config.ts",
    "config:show": "tsx scripts/config.ts --show",
    "config:schema": "tsx scripts/config-schema.ts",
    "licenses:refresh": "node scripts/licensing/refresh.mjs",
    "licenses:check": "node --test scripts/licensing/check.test.mjs && node scripts/licensing/check.mjs",
    "config:apply": "tsx scripts/config-apply.ts",
    "config:status": "tsx scripts/config-apply.ts --status"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.1",
    "@opencode/client": "2.0.28",
    "@opencode/plugin": "2.0.28",
    "@opencode/schema": "2.0.28",
    "@opencode/util": "2.0.28",
    "@toon-format/toon": "4.4.0",
    "diff": "9.0.0",
    "effect": "4.0.1",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@effect/tsgo": "0.53.0",
    "@fission-ai/openspec": "1.13.2",
    "@opencode/cli": "2.0.28",
    "@opencode/theme": "2.0.28",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@types/node": "24.12.2",
    "agent-browser": "0.39.1",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "solid-js": "1.9.12",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vite-plus": "1.2.0"
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.28.5"
}
